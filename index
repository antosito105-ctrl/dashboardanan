<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Order Parfum App - Realtime Sync</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
        .spinner { animation: spin 1s linear infinite; }
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .loading-overlay { display: none; position: fixed; inset: 0; background: rgba(255,255,255,0.8); z-index: 100; align-items: center; justify-content: center; flex-direction: column; gap: 10px; }
        .order-done { opacity: 0.6; background-color: #f0fdf4 !important; }
        .order-done .text-content { text-decoration: line-through; }
    </style>
</head>
<body class="p-4 md:p-8">
    <!-- Overlay Loading Global -->
    <div id="loader" class="loading-overlay">
        <i class="fas fa-circle-notch spinner text-4xl text-blue-600"></i>
        <p class="text-sm font-bold text-slate-600">Menyinkronkan Data...</p>
    </div>

    <div class="max-w-5xl mx-auto">
        <header class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold text-slate-800 flex items-center gap-3">
                    Order Parfum 📦
                </h1>
                <p class="text-slate-500 mt-1">Data Realtime dari Google Sheets</p>
            </div>
            <div class="flex gap-2">
                <button onclick="fetchDataDariSheet()" class="bg-blue-600 text-white px-5 py-2.5 rounded-xl hover:bg-blue-700 transition flex items-center gap-2 font-bold shadow-lg shadow-blue-200">
                    <i class="fas fa-sync-alt" id="syncIcon"></i> Refresh Data
                </button>
            </div>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Form Input -->
            <div class="lg:col-span-1">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 sticky top-8">
                    <h2 class="text-lg font-semibold mb-4 text-slate-800 flex items-center gap-2">
                        <i class="fas fa-edit text-blue-500"></i> Input Pesanan
                    </h2>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-400 mb-1">Nama Pembeli</label>
                            <input type="text" id="nama" placeholder="Nama pelanggan..." class="w-full px-4 py-3 rounded-xl border border-slate-200 outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-400 mb-1">Nomor WA</label>
                            <input type="text" id="wa" placeholder="0812..." class="w-full px-4 py-3 rounded-xl border border-slate-200 outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-400 mb-1">Nama Produk</label>
                            <input type="text" id="produk" placeholder="Varian parfum..." class="w-full px-4 py-3 rounded-xl border border-slate-200 outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-xs font-bold text-slate-400 mb-1">Tanggal</label>
                                <input type="date" id="tgl" class="w-full px-3 py-3 rounded-xl border border-slate-200 outline-none text-sm bg-white">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-400 mb-1">Ekspedisi</label>
                                <select id="ekspedisi" class="w-full px-3 py-3 rounded-xl border border-slate-200 bg-white outline-none text-sm">
                                    <option value="jne">JNE</option>
                                    <option value="jnt">J&T</option>
                                    <option value="sicepat">SiCepat</option>
                                    <option value="shopee">SPX</option>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-400 mb-1">Nomor Resi</label>
                            <input type="text" id="resi" placeholder="Resi pengiriman..." class="w-full px-4 py-3 rounded-xl border border-slate-200 outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <button id="btnSimpan" onclick="tambahOrder()" class="w-full bg-blue-600 text-white font-bold py-4 rounded-xl shadow-lg hover:bg-blue-700 transition flex justify-center items-center gap-2">
                            <i class="fas fa-paper-plane"></i> Kirim ke Sheets
                        </button>
                    </div>
                </div>
            </div>

            <!-- List Data -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="px-6 py-4 bg-white border-b border-slate-100 flex justify-between items-center">
                        <h2 class="font-bold text-slate-700">Database Pesanan</h2>
                        <span id="orderCount" class="text-[11px] bg-blue-50 text-blue-600 px-3 py-1 rounded-full font-bold border border-blue-100">0 Order</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left" id="tabelOrder">
                            <thead class="bg-slate-50 text-slate-500 text-[10px] uppercase font-bold">
                                <tr>
                                    <th class="px-6 py-4">Informasi Pembeli</th>
                                    <th class="px-6 py-4">Detail Paket</th>
                                    <th class="px-6 py-4 text-right">Kontrol</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100"></tbody>
                        </table>
                    </div>
                    <div id="emptyState" class="p-20 text-center text-slate-400 hidden">
                        <i class="fas fa-cloud-download-alt text-4xl mb-4 block opacity-20"></i>
                        <p class="text-sm font-medium">Data tidak ditemukan di database</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notifikasi -->
    <div id="toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 translate-y-20 opacity-0 bg-slate-900 text-white px-6 py-3 rounded-2xl transition-all duration-300 z-50 text-sm shadow-2xl flex items-center gap-3"></div>

    <script>
        // GANTI DENGAN URL WEB APP GOOGLE SCRIPT KAMU
        const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwoQ9WTWoTbEuc8wK20_j6PIHFBM9xxy993waOeF0uc2txCMzROywWgvtMkehdFYwuEHA/exec';

        let dataOrder = [];

        function showLoading(show) {
            document.getElementById('loader').style.display = show ? 'flex' : 'none';
        }

        function showToast(msg, isError = false) {
            const toast = document.getElementById('toast');
            toast.innerHTML = isError ? `<i class="fas fa-times-circle text-red-400"></i> ${msg}` : `<i class="fas fa-check-circle text-green-400"></i> ${msg}`;
            toast.style.border = isError ? '1px solid #ef4444' : '1px solid #10b981';
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 3000);
        }

        // AMBIL DATA REALTIME DARI SPREADSHEET
        async function fetchDataDariSheet() {
            const icon = document.getElementById('syncIcon');
            icon.classList.add('spinner');
            
            try {
                // Gunakan cache buster agar browser tidak mengambil data lama
                const response = await fetch(`${SCRIPT_URL}?action=read&nocache=${new Date().getTime()}`);
                const data = await response.json();
                
                if (Array.isArray(data)) {
                    dataOrder = data;
                    renderTabel();
                }
            } catch (e) {
                showToast('Gagal terhubung ke database', true);
            } finally {
                icon.classList.remove('spinner');
            }
        }

        async function tambahOrder() {
            const btn = document.getElementById('btnSimpan');
            const payload = {
                action: 'create',
                nama: document.getElementById('nama').value,
                wa: document.getElementById('wa').value,
                produk: document.getElementById('produk').value,
                tgl: document.getElementById('tgl').value,
                ekspedisi: document.getElementById('ekspedisi').value,
                resi: document.getElementById('resi').value,
                selesai: false
            };

            if (!payload.nama || !payload.resi) return showToast('Nama & Resi wajib diisi!', true);

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-circle-notch spinner"></i> Mengirim...';

            try {
                // Kirim data menggunakan mode: 'no-cors' untuk menghindari masalah CORS di Web App
                await fetch(SCRIPT_URL, { 
                    method: 'POST', 
                    mode: 'no-cors', 
                    cache: 'no-cache',
                    body: JSON.stringify(payload) 
                });
                
                showToast('Data berhasil disimpan ke database!');
                ['nama', 'wa', 'produk', 'resi'].forEach(id => document.getElementById(id).value = '');
                
                // Tunggu sebentar lalu refresh data agar dashboard update
                setTimeout(fetchDataDariSheet, 2000);
            } catch (e) {
                showToast('Gagal mengirim data', true);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> Kirim ke Sheets';
            }
        }

        async function updateStatusSelesai(index) {
            const order = dataOrder[index];
            showLoading(true);
            try {
                // Logika toggle status
                const currentStatus = (order.selesai === true || order.selesai === "TRUE");
                
                await fetch(SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    body: JSON.stringify({
                        action: 'update',
                        resi: order.resi,
                        selesai: !currentStatus
                    })
                });
                showToast('Status pesanan diperbarui');
                setTimeout(fetchDataDariSheet, 1500);
            } catch (e) {
                showToast('Gagal update status', true);
                showLoading(false);
            }
        }

        async function hapusOrderOnline(index) {
            const order = dataOrder[index];
            if(!confirm(`⚠️ HAPUS PERMANEN?\n\nPesanan atas nama "${order.nama}" akan dihapus dari Google Sheets.`)) return;

            showLoading(true);
            try {
                await fetch(SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    body: JSON.stringify({
                        action: 'delete',
                        resi: order.resi
                    })
                });
                showToast('Data sedang dihapus...');
                setTimeout(fetchDataDariSheet, 2000);
            } catch (e) {
                showToast('Gagal menghapus data', true);
                showLoading(false);
            }
        }

        function renderTabel() {
            const tbody = document.querySelector('#tabelOrder tbody');
            const emptyState = document.getElementById('emptyState');
            const countBadge = document.getElementById('orderCount');
            tbody.innerHTML = '';
            countBadge.innerText = `${dataOrder.length} Order`;

            if (dataOrder.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
                dataOrder.forEach((o, i) => {
                    const isDone = (o.selesai === true || o.selesai === "TRUE");
                    const rowClass = isDone ? 'order-done' : '';
                    const checkIcon = isDone ? 'fa-undo' : 'fa-check';
                    const checkColor = isDone ? 'text-orange-500 bg-orange-50' : 'text-green-600 bg-green-50';

                    tbody.innerHTML += `
                    <tr class="${rowClass} hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="font-bold text-slate-800 text-sm text-content">${o.nama}</div>
                            <div class="text-[11px] text-blue-500 font-semibold italic">${o.wa || '-'}</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-xs text-slate-600 text-content font-medium">${o.produk}</div>
                            <div class="text-[10px] text-slate-400 font-mono mt-1">
                                <span class="bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded font-bold">${o.ekspedisi.toUpperCase()}</span> ${o.resi}
                            </div>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex justify-end gap-2">
                                <button onclick="updateStatusSelesai(${i})" class="w-9 h-9 rounded-xl ${checkColor} hover:scale-105 transition-all flex items-center justify-center" title="Ubah Status">
                                    <i class="fas ${checkIcon} text-xs"></i>
                                </button>
                                <button onclick="hapusOrderOnline(${i})" class="w-9 h-9 rounded-xl bg-red-50 text-red-500 hover:bg-red-500 hover:text-white transition-all flex items-center justify-center" title="Hapus">
                                    <i class="fas fa-trash-alt text-xs"></i>
                                </button>
                            </div>
                        </td>
                    </tr>`;
                });
            }
            showLoading(false);
        }

        // Set tanggal hari ini & Ambil data saat aplikasi dibuka
        document.getElementById('tgl').valueAsDate = new Date();
        window.addEventListener('load', () => {
            showLoading(true);
            fetchDataDariSheet();
        });
    </script>
</body>
</html>
